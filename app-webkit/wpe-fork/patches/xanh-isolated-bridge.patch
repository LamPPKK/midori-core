+
+bool isBridgeName(const char* value) noexcept
+{
+    if (!value || !g_ascii_isalpha(*value))
+        return false;
+    size_t length = 1;
+    for (const char* current = value + 1; *current; ++current, ++length) {
+        if (length >= 64 || (!g_ascii_isalnum(*current) && *current != '_'))
+            return false;
+    }
+    return length <= 64;
+}
+
+bool isArgumentName(const char* value) noexcept
+{
+    if (!value || (!g_ascii_isalpha(*value) && *value != '_' && *value != '$'))
+        return false;
+    size_t length = 1;
+    for (const char* current = value + 1; *current; ++current, ++length) {
+        if (length >= 64)
+            return false;
+        if (!g_ascii_isalnum(*current) && *current != '_' && *current != '$')
+            return false;
+    }
+    return length <= 64;
+}
+
+bool javaStringToUtf8(JNIEnv* env, jstring input, std::string& output) noexcept
+{
+    if (!env || !input)
+        return false;
+    jsize length = env->GetStringLength(input);
+    const jchar* characters = env->GetStringChars(input, nullptr);
+    if (!characters)
+        return false;
+    GError* error = nullptr;
+    g_autofree gchar* utf8 = g_utf16_to_utf8(
+        reinterpret_cast<const gunichar2*>(characters), length, nullptr, nullptr, &error);
+    env->ReleaseStringChars(input, characters);
+    if (!utf8) {
+        g_clear_error(&error);
+        return false;
+    }
+    output.assign(utf8);
+    return true;
+}
 
