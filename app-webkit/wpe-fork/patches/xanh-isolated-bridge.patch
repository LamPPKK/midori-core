+            m_userContentManager, m_isolatedHandlerName.c_str(), m_isolatedWorldName.c_str());
+    }
+    if (m_isolatedUserScript) {
+        webkit_user_content_manager_remove_script(m_userContentManager, m_isolatedUserScript);
+        webkit_user_script_unref(m_isolatedUserScript);
