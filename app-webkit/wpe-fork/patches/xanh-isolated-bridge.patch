+void WKWebView::removeIsolatedBridge() noexcept
+{
+    if (!m_userContentManager)
+        return;
+    if (m_isolatedMessageSignal) {
+        g_signal_handler_disconnect(m_userContentManager, m_isolatedMessageSignal);
+        m_isolatedMessageSignal = 0;
+    }
