+jboolean JNIWKWebViewCache::nativeInstallIsolatedBridge(JNIEnv* env, jobject /*obj*/, jlong wkWebViewPtr,
+    jstring source, jstring worldName, jstring handlerName) noexcept
+{
+    auto* wkWebView = reinterpret_cast<WKWebView*>(wkWebViewPtr); // NOLINT(performance-no-int-to-ptr)
+    if (!wkWebView || !wkWebView->m_userContentManager)
+        return JNI_FALSE;
+
+    std::string sourceUtf8;
+    std::string worldUtf8;
+    std::string handlerUtf8;
+    if (!javaStringToUtf8(env, source, sourceUtf8) || !javaStringToUtf8(env, worldName, worldUtf8)
+        || !javaStringToUtf8(env, handlerName, handlerUtf8) || sourceUtf8.size() > maxBridgeSourceBytes
+        || !isBridgeName(worldUtf8.c_str()) || !isBridgeName(handlerUtf8.c_str()))
+        return JNI_FALSE;
+
+    wkWebView->removeIsolatedBridge();
+    g_autofree gchar* signalName = g_strdup_printf("script-message-received::%s", handlerUtf8.c_str());
+    gulong signal = g_signal_connect(wkWebView->m_userContentManager, signalName,
+        G_CALLBACK(JNIWKWebViewCache::onIsolatedScriptMessage), wkWebView);
+    if (!signal || !webkit_user_content_manager_register_script_message_handler_in_world(
+                       wkWebView->m_userContentManager, handlerUtf8.c_str(), worldUtf8.c_str())) {
+        if (signal)
+            g_signal_handler_disconnect(wkWebView->m_userContentManager, signal);
+        return JNI_FALSE;
+    }
+
+    const gchar* allowedSchemes[] = {"http://*/*", "https://*/*", nullptr};
+    WebKitUserScript* script = webkit_user_script_new_for_world(sourceUtf8.c_str(),
+        WEBKIT_USER_CONTENT_INJECT_TOP_FRAME, WEBKIT_USER_SCRIPT_INJECT_AT_DOCUMENT_START, worldUtf8.c_str(),
+        allowedSchemes, nullptr);
+    if (!script) {
+        g_signal_handler_disconnect(wkWebView->m_userContentManager, signal);
+        webkit_user_content_manager_unregister_script_message_handler_in_world(
+            wkWebView->m_userContentManager, handlerUtf8.c_str(), worldUtf8.c_str());
+        return JNI_FALSE;
+    }
+
+    webkit_user_content_manager_add_script(wkWebView->m_userContentManager, script);
+    wkWebView->m_isolatedUserScript = script;
+    wkWebView->m_isolatedMessageSignal = signal;
+    wkWebView->m_isolatedWorldName = worldUtf8;
+    wkWebView->m_isolatedHandlerName = handlerUtf8;
+    return JNI_TRUE;
+}
+
+void JNIWKWebViewCache::nativeRemoveIsolatedBridge(
+    JNIEnv* /*env*/, jobject /*obj*/, jlong wkWebViewPtr) noexcept
+{
+    auto* wkWebView = reinterpret_cast<WKWebView*>(wkWebViewPtr); // NOLINT(performance-no-int-to-ptr)
+    if (wkWebView)
+        wkWebView->removeIsolatedBridge();
+}
+
+void JNIWKWebViewCache::nativeCallIsolatedJavascriptFunction(JNIEnv* env, jobject /*obj*/, jlong wkWebViewPtr,
+    jstring body, jstringArray argumentNames, jstringArray argumentValues, jstring worldName,
+    JNIWKCallback callback) noexcept
+{
+    auto reject = [callback]() {
+        if (callback)
+            WKCallback::onStringResult(callback, nullptr);
+    };
+    auto* wkWebView = reinterpret_cast<WKWebView*>(wkWebViewPtr); // NOLINT(performance-no-int-to-ptr)
+    if (!wkWebView || !wkWebView->m_webView || !wkWebView->m_isolatedUserScript || !argumentNames
+        || !argumentValues) {
+        reject();
+        return;
+    }
+
+    std::string bodyUtf8;
+    std::string worldUtf8;
+    jsize nameCount = env->GetArrayLength(argumentNames);
+    jsize valueCount = env->GetArrayLength(argumentValues);
+    if (!javaStringToUtf8(env, body, bodyUtf8) || !javaStringToUtf8(env, worldName, worldUtf8)
+        || bodyUtf8.size() > maxFunctionBodyBytes || worldUtf8 != wkWebView->m_isolatedWorldName
+        || nameCount != valueCount || nameCount < 0 || static_cast<size_t>(nameCount) > maxArguments) {
+        reject();
+        return;
+    }
+
+    GVariantBuilder builder;
+    g_variant_builder_init(&builder, G_VARIANT_TYPE_VARDICT);
+    for (jsize index = 0; index < nameCount; ++index) {
+        auto name = static_cast<jstring>(
+            env->GetObjectArrayElement(reinterpret_cast<jobjectArray>(argumentNames), index));
+        auto value = static_cast<jstring>(
+            env->GetObjectArrayElement(reinterpret_cast<jobjectArray>(argumentValues), index));
+        std::string nameUtf8;
+        std::string valueUtf8;
+        bool valid = javaStringToUtf8(env, name, nameUtf8) && javaStringToUtf8(env, value, valueUtf8)
+            && isArgumentName(nameUtf8.c_str()) && valueUtf8.size() <= maxArgumentValueBytes;
+        env->DeleteLocalRef(name);
+        env->DeleteLocalRef(value);
+        if (!valid) {
+            g_variant_builder_clear(&builder);
+            reject();
+            return;
+        }
+        g_variant_builder_add(&builder, "{sv}", nameUtf8.c_str(), g_variant_new_string(valueUtf8.c_str()));
+    }
+    g_autoptr(GVariant) arguments = g_variant_ref_sink(g_variant_builder_end(&builder));
+    JNIWKCallback globalCallback
+        = callback ? reinterpret_cast<JNIWKCallback>(env->NewGlobalRef(callback)) : nullptr;
+    if (callback && !globalCallback)
+        return;
+    webkit_web_view_call_async_javascript_function(wkWebView->m_webView, bodyUtf8.c_str(), -1, arguments,
+        worldUtf8.c_str(), "xanh-browser-wpe://isolated-bridge", nullptr,
+        globalCallback ? reinterpret_cast<GAsyncReadyCallback>(onCallIsolatedJavascriptReady) : nullptr,
+        globalCallback);
+}
