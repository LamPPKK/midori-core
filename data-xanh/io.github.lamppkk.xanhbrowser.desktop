[Desktop Entry]
Type=Application
Name=Xanh Browser
GenericName=Web Browser
Comment=Browse the web with privacy-minded defaults
Exec=xanh-browser %U
Icon=io.github.lamppkk.xanhbrowser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/xanh-browser;
StartupNotify=true
DBusActivatable=true
