<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>XanhBrowser.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\XanhBrowser.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Xanh Browser</Product>
    <XanhFirefoxSyncMozillaHosted Condition="'$(XanhFirefoxSyncMozillaHosted)' == ''">false</XanhFirefoxSyncMozillaHosted>
    <XanhFxaProductionApproved Condition="'$(XanhFxaProductionApproved)' == ''">0</XanhFxaProductionApproved>
    <XanhFxaClientId Condition="'$(XanhFxaClientId)' == ''"></XanhFxaClientId>
    <XanhSyncNativeDll Condition="'$(XanhSyncNativeDll)' == ''"></XanhSyncNativeDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../XanhBrowser.Core/XanhBrowser.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>XanhFxaClientId</_Parameter1>
      <_Parameter2>$(XanhFxaClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>XanhFxaProductionApproved</_Parameter1>
      <_Parameter2>$(XanhFxaProductionApproved)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(XanhSyncNativeDll)' != ''">
    <Content Include="$(XanhSyncNativeDll)"
             Link="xanh_sync_core.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateMozillaHostedFirefoxSyncPackage"
          BeforeTargets="PrepareForBuild"
          Condition="'$(XanhFirefoxSyncMozillaHosted)' == 'true'">
    <Error Condition="'$(XanhFxaProductionApproved)' != '1'"
           Text="A production Firefox Sync package requires written Mozilla approval (XanhFxaProductionApproved=1). Use the self-hosted release path otherwise." />
    <Error Condition="'$(XanhFxaClientId)' == ''"
           Text="A production Firefox Sync package requires XanhFxaClientId." />
    <Error Condition="'$(XanhSyncNativeDll)' == '' or !Exists('$(XanhSyncNativeDll)')"
           Text="A production Firefox Sync package requires an existing architecture-matched XanhSyncNativeDll." />
  </Target>
</Project>
