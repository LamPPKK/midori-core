<?xml version="1.0" encoding="UTF-8"?>
<interface><requires lib="gtk" version="4.10"/><object class="GtkApplicationWindow" id="browser"><property name="title">Xanh Browser</property><property name="default-width">1100</property><property name="default-height">760</property><child><object class="GtkBox"><property name="orientation">vertical</property><child><object class="GtkProgressBar" id="progress"><property name="visible">false</property></object></child><child><object class="GtkNotebook" id="tabs"><property name="hexpand">true</property><property name="vexpand">true</property><property name="scrollable">true</property></object></child></object></child></object></interface>
